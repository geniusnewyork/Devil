# MONTY GENIUS // SECURE LINK HUB - Environment Configuration

# Node Environment
NODE_ENV=development
PORT=3000

# Database Configuration (SQLite file path for Prisma)
DATABASE_URL="file:./data/monty_genius.db"

# Session Security Secret (Use minimum 32 random characters in production)
SESSION_SECRET="MONTY_GENIUS_SUPER_SECURE_RANDOM_SESSION_SECRET_KEY_2026_#"

# Initial Admin Password (Used on first database seed only, then automatically hashed)
ADMIN_INITIAL_USERNAME="Genius"
ADMIN_INITIAL_PASSWORD="Genius"

# Optional Security Cooldown Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
